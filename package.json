    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "dexie": "^4.0.10",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
